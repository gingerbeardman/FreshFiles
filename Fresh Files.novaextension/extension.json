{
    "identifier": "com.gingerbeardman.FreshFiles",
    "name": "Fresh Files",
    "organization": "gingerbeardman",
    "description": "An alternative file browser sidebar that shows only recently modified files",
    "version": "3.3.0",
    "bugs": "https://github.com/gingerbeardman/FreshFiles/issues",
    "homepage": "https://github.com/gingerbeardman/FreshFiles",
    "repository": "https://github.com/gingerbeardman/FreshFiles",

    "categories": ["sidebars"],

    "main": "main.js",

    "activationEvents": [
        "*"
    ],

    "entitlements": {
        "clipboard": true,
        "filesystem": "readwrite",
        "process": true
    },

    "configWorkspace": [
        {
            "key": "com.gingerbeardman.FreshFiles.timeWindow",
            "title": "Time Window",
            "description": "How far back to look for modified files.\n\"Pending\" shows uncommitted changes.",
            "type": "enum",
            "values": [
                ["pending", "Pending Changes"],
                ["1h", "Last 1 Hour"],
                ["4h", "Last 4 Hours"],
                ["1d", "Last 1 Day"],
                ["3d", "Last 3 Days"],
                ["7d", "Last 7 Days"],
                ["14d", "Last 14 Days"],
                ["30d", "Last 30 Days"],
                ["90d", "Last 90 Days"],
                ["180d", "Last 180 Days"],
                ["360d", "Last 360 Days"]
            ],
            "default": "pending"
        },
        {
            "key": "com.gingerbeardman.FreshFiles.respectGitignore",
            "title": "Respect .gitignore",
            "description": "Hide files matched by the repository's root .gitignore.",
            "type": "boolean",
            "default": true
        },
        {
            "key": "com.gingerbeardman.FreshFiles.ignoredPatterns",
            "title": "Custom Ignored Patterns",
            "description": "Extra glob patterns to hide on top of .gitignore.",
            "type": "stringArray",
            "default": []
        },
        {
            "key": "com.gingerbeardman.FreshFiles.maxFiles",
            "title": "Max Files",
            "description": "Cap on files shown. Prevents slowdowns in large repos.",
            "type": "number",
            "default": 5000,
            "min": 100,
            "max": 100000
        },
        {
            "key": "com.gingerbeardman.FreshFiles.pinnedFiles",
            "title": "Pinned Files",
            "description": "Files always shown in the sidebar, regardless of time window.",
            "type": "stringArray",
            "default": []
        }
    ],

    "sidebars": [
        {
            "id": "com.gingerbeardman.FreshFiles.sidebar",
            "name": "Fresh Files",
            "smallImage": "sidebar-small",
            "largeImage": "sidebar-large",
            "sections": [
                {
                    "id": "com.gingerbeardman.FreshFiles.section",
                    "name": "Fresh Files",
                    "placeholderText": "No recently modified files found.",
                    "placeholderImage": "sidebar-large",
                    "headerCommands": [
                        {
                            "title": "Sort",
                            "image": "sort",
                            "tooltip": "Toggle sort order",
                            "command": "freshFiles.toggleSort"
                        },
                        {
                            "title": "Flat/Tree",
                            "image": "__builtin.path",
                            "tooltip": "Toggle between flat list and directory tree",
                            "command": "freshFiles.toggleFlat"
                        },
                        {
                            "title": "Time Window",
                            "image": "__builtin.action",
                            "tooltip": "Set time window",
                            "command": "freshFiles.setTimeWindow"
                        },
                        {
                            "title": "Show All",
                            "image": "__builtin.eye",
                            "tooltip": "Toggle show all tracked files",
                            "command": "freshFiles.toggleShowAll"
                        }
                    ],
                    "contextCommands": [
                        {
                            "title": "New File…",
                            "command": "freshFiles.newFile"
                        },
                        {
                            "separator": true
                        },
                        {
                            "title": "Show in Finder",
                            "command": "freshFiles.revealInFinder"
                        },
                        {
                            "title": "Copy Path",
                            "command": "freshFiles.copyPath"
                        },
                        {
                            "title": "Copy Relative Path",
                            "command": "freshFiles.copyRelativePath"
                        },
                        {
                            "separator": true
                        },
                        {
                            "title": "Move to Trash",
                            "command": "freshFiles.moveToTrash"
                        },
                        {
                            "separator": true
                        },
                        {
                            "title": "Pin File",
                            "command": "freshFiles.pinFile"
                        },
                        {
                            "title": "Unpin File",
                            "command": "freshFiles.unpinFile"
                        },
                        {
                            "separator": true
                        },
                        {
                            "title": "Add to Custom Ignored",
                            "command": "freshFiles.addToIgnored"
                        },
                        {
                            "title": "Add to .gitignore",
                            "command": "freshFiles.addToGitignore"
                        },
                        {
                            "separator": true
                        },
                        {
                            "title": "Show File History",
                            "command": "freshFiles.showFileHistory"
                        },
                        {
                            "separator": true
                        },
                        {
                            "title": "Exhume (View Deleted)",
                            "command": "freshFiles.exhume",
                            "when": "viewItem == 'deleted'"
                        },
                        {
                            "title": "Resurrect (Restore Deleted)",
                            "command": "freshFiles.resurrect",
                            "when": "viewItem == 'deleted'"
                        },
                        {
                            "title": "Diff Search…",
                            "command": "freshFiles.diffSearch"
                        }
                    ]
                }
            ]
        }
    ],

    "commands": {
        "extensions": [
            {
                "title": "Refresh Fresh Files",
                "command": "freshFiles.refresh"
            },
            {
                "title": "Set Time Window…",
                "command": "freshFiles.setTimeWindow"
            },
            {
                "title": "Cycle Time Window",
                "command": "freshFiles.cycleTimeWindow"
            },
            {
                "title": "Toggle Sort Order (Recency/Name)",
                "command": "freshFiles.toggleSort"
            },
            {
                "title": "Toggle Layout (Flat/Tree)",
                "command": "freshFiles.toggleFlat"
            },
            {
                "title": "Quick Open Fresh File…",
                "command": "freshFiles.quickOpen"
            },
            {
                "title": "Diff Search (Pickaxe)…",
                "command": "freshFiles.diffSearchRepo"
            },
            {
                "title": "Line History…",
                "command": "freshFiles.lineHistory"
            },
            {
                "title": "Search Fresh Files…",
                "command": "freshFiles.searchFiles"
            }
        ]
    }
}
